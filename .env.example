# URL pública da API (incluindo o prefixo /api/v1).
# Usada em TEMPO DE BUILD pelo Vite — após alterar, refaça o build.
# Em desenvolvimento, se omitida, o padrão é http://localhost:8080/api/v1
# Em produção, se omitida, o padrão é /api/v1 (mesma origem).
VITE_API_BASE_URL=http://localhost:8080/api/v1
